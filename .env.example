# Copy this file to .env for local dev (wrangler picks up .dev.vars, see README),
# and set the same names as Environment Variables / Secrets in the Cloudflare
# Pages dashboard for production. Never commit a real .env or .dev.vars file.

# Which provider to try first: "groq" | "workers-ai" | "ollama"
AI_PROVIDER=groq

# Optional: if the primary provider errors, try this one once. Leave blank to disable.
FALLBACK_AI_PROVIDER=workers-ai

# --- Groq (https://console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cloudflare Workers AI ---
# No API key needed here — it uses the native `AI` binding configured in wrangler.toml
# / the Pages dashboard, not an HTTP key.
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- Ollama (local development only) ---
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Limits / cost protection ---
MAX_INPUT_CHARS=6000
MAX_REQUEST_BYTES=65536
MAX_REQUESTS_PER_IP_PER_DAY=30

# --- CORS ---
# Set to your real deployed origin in production, e.g. https://textshift.pages.dev
ALLOWED_ORIGIN=*
